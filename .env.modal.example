# Variables for the local shell that runs `modal deploy modal_app.py`.
MODAL_APP_NAME=ovarian-cellexlink-hgnc-chebi
MODAL_MODEL_VOLUME_NAME=ovarian-cellexlink-hgnc-chebi-model-cache
# Keep false until the Railway volume, credentials, and update token are ready.
MODAL_MONTHLY_SCHEDULE_ENABLED=false
MODAL_MONTHLY_CRON="0 3 1 * *"
MODAL_MONTHLY_SECRET_NAME=ovarian-monthly-update
# In the Modal secret named above, set these two values (never commit them):
# CORPUS_UPDATE_BASE_URL=https://your-service.up.railway.app
# MONTHLY_UPDATE_TOKEN=<same private token used by the Railway web service>
