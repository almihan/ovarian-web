NCBI_EMAIL=""
APP_ENV=development
PUBLIC_PRECOMPUTED_ONLY=false
MONTHLY_UPDATES_ENABLED=false
MODAL_MONTHLY_SCHEDULE_ENABLED=false
MONTHLY_UPDATE_MAX_NEW_PAPERS=300
MONTHLY_UPDATE_TOKEN=""
CELL_ANNOTATION_BACKEND=local
CELL_LOCAL_DEVICE=auto
# Keep CellExLink checkpoints and ontology embeddings outside extracted ZIPs.
CELL_MODEL_CACHE_DIR="~/.cache/ovarian-network/cellexlink"
CELL_NORMALIZATION_METHOD_LOG=true
OPENAI_API_KEY=""
OPENAI_RELATION_MODEL="gpt-5.4-nano"
RELATION_REASONING_EFFORT="low"
RELATION_PROMPT_CACHE_KEY="ovarian-relations-four-predicates"

CELL_NEN_BATCH_SIZE=128
