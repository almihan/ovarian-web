# Copy these variables into the Railway web service. Do not commit real keys.

APP_ENV=production
PUBLIC_PRECOMPUTED_ONLY=true
APP_DATA_DIR=/data
PRECOMPUTED_CORPORA_DIR=/data/precomputed_corpora
CELL_ANNOTATION_BACKEND=modal
MODAL_APP_NAME=ovarian-cellexlink-hgnc-chebi
MODAL_FUNCTION_NAME=annotate_bundle
MODAL_TOKEN_ID=""
MODAL_TOKEN_SECRET=""
NCBI_EMAIL=""
NCBI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_RELATION_MODEL=gpt-5.4
RELATION_REASONING_EFFORT=low
# Use a private S3-compatible bucket so Modal can read/write artifact bundles.
ARTIFACT_BACKEND=s3
ARTIFACT_BUCKET=""
ARTIFACT_ENDPOINT=""
ARTIFACT_ACCESS_KEY_ID=""
ARTIFACT_SECRET_ACCESS_KEY=""
ARTIFACT_REGION=auto
PUBLIC_BASE_URL=""
# Updates remain off until explicitly enabled.
MONTHLY_UPDATES_ENABLED=false
MONTHLY_UPDATE_MAX_NEW_PAPERS=300
MONTHLY_UPDATE_TEXT_MODE=fulltext
# Set a long random token here and in the Modal monthly-update secret.
MONTHLY_UPDATE_TOKEN=""
